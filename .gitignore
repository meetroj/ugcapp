# ---- Signing keys and secrets — NEVER commit these ----
# The release keystore signs every shipped build. Leaking it lets anyone
# publish apps as you, and losing it means you can never update this app on
# Play again. gradle.properties holds its passwords in plaintext.
*.keystore
*.jks
android/gradle.properties
.env
.env.*

